rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // دالة مساعدة: هل المستخدم أدمن؟
    // ============================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwnerBrandManager(brandId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "brand_manager" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.brandId == brandId;
    }

    // ============================================
    // Users: كل حد يقرا بياناته بس، الأدمن يقدر يقرا للكل
    // ============================================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // ============================================
    // Brands
    // ============================================
    match /brands/{brandId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwnerBrandManager(brandId);
      allow delete: if isAdmin();
    }

    // ============================================
    // Products
    // ============================================
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || isOwnerBrandManager(request.resource.data.brandId);
      allow update, delete: if isAdmin() || isOwnerBrandManager(resource.data.brandId);
    }

    // ============================================
    // JoinRequests
    // ============================================
    match /joinRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================
    // Orders
    // ============================================
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || isOwnerBrandManager(resource.data.brandId);
      allow update: if isAdmin() || isOwnerBrandManager(resource.data.brandId);
      allow delete: if isAdmin();
    }

    // ============================================
    // Reviews
    // ============================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ============================================
    // Activity Log
    // ============================================
    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ============================================
    // Site Feedback
    // ============================================
    match /siteFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // ============================================
    // Categories
    // ============================================
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
